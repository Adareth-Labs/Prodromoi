{
  "name": "precisioncore-public",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev":              "next dev",
    "build":            "next build",
    "start":            "next start",
    "lint":             "next lint",
    "type-check":       "tsc --noEmit",
    "payload:generate": "payload generate:types && payload generate:importmap",
    "payload:migrate":  "payload migrate",
    "migrate:contentful":          "tsx scripts/migrate-contentful-to-payload.ts",
    "migrate:contentful:dry-run":  "tsx scripts/migrate-contentful-to-payload.ts --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3":            "^3.614.0",
    "@aws-sdk/s3-request-presigner": "^3.614.0",
    "@payloadcms/db-postgres":       "^3.0.0",
    "@payloadcms/email-nodemailer":  "^3.0.0",
    "@payloadcms/next":              "^3.0.0",
    "@payloadcms/richtext-lexical":  "^3.0.0",
    "@payloadcms/storage-s3":        "^3.0.0",
    "@payloadcms/translations":      "^3.0.0",
    "clsx":                          "^2.1.1",
    "contentful":                    "^10.15.0",
    "date-fns":                      "^3.6.0",
    "next":                          "^16.2.7",
    "nodemailer":                    "^6.9.14",
    "payload":                       "^3.0.0",
    "react":                         "^18.3.1",
    "react-dom":                     "^18.3.1",
    "zod":                           "^3.23.8"
  },
  "devDependencies": {
    "@types/nodemailer":   "^6.4.15",
    "@types/node":         "^20.14.11",
    "@types/react":        "^18.3.3",
    "@types/react-dom":    "^18.3.0",
    "autoprefixer":        "^10.4.19",
    "eslint":              "^8.57.1",
    "eslint-config-next":  "^16.2.7",
    "postcss":             "^8.5.10",
    "tailwindcss":         "^3.4.6",
    "tsx":                 "^4.19.0",
    "typescript":          "^5.5.3"
  }
}
