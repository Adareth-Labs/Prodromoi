# Payload CMS / Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=payload
PAYLOAD_SECRET=YOUR_PAYLOAD_SECRET

# Supabase Storage S3 protocol (server-only credentials generated from Storage > S3 Configuration)
SUPABASE_STORAGE_S3_ENDPOINT=https://YOUR_STORAGE_PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_S3_REGION=eu-west-1
SUPABASE_STORAGE_S3_ACCESS_KEY_ID=YOUR_SUPABASE_STORAGE_S3_ACCESS_KEY_ID
SUPABASE_STORAGE_S3_SECRET_ACCESS_KEY=YOUR_SUPABASE_STORAGE_S3_SECRET_ACCESS_KEY
SUPABASE_STORAGE_PUBLIC_URL=https://YOUR_STORAGE_PROJECT_REF.supabase.co/storage/v1/object/public
SUPABASE_STORAGE_CMS_BUCKET=site-media
SUPABASE_STORAGE_INVESTOR_BUCKET=partner-private
SUPABASE_STORAGE_INVESTOR_PREFIX=investor-documents
STORAGE_SIGNED_URL_EXPIRY=3600

# Public bucket URL base used for optimized automotive images (append /automotive/<filename>)
NEXT_PUBLIC_SUPABASE_STORAGE_PUBLIC_URL=https://YOUR_STORAGE_PROJECT_REF.supabase.co/storage/v1/object/public/site-media

# LEGACY CLOUDFLARE R2 CONFIG — disabled; retained for rollback reference only.
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
# R2_CMS_BUCKET=precisioncore-cms
# R2_INVESTOR_BUCKET=precisioncore-investor-documents
# R2_PRESIGN_EXPIRY=3600
# R2_PUBLIC_URL=https://YOUR_R2_PUBLIC_DOMAIN
# SMTP2Go
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=cms@precisioncore.com

# Careers / ATS
ATS_API_KEY=YOUR_ATS_API_KEY
ATS_BOARD_TOKEN=YOUR_ATS_BOARD_TOKEN
REVALIDATE_CAREERS=300

# Public API
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002 # Set to your deployed API URL in production
# Optional: comma-separated LAN hostnames for Next.js development only
# NEXT_ALLOWED_DEV_ORIGINS=192.168.1.20

# Public URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000

# ISR revalidation
REVALIDATION_SECRET=YOUR_REVALIDATION_SECRET
# Configure the same secret in the Vercel Cron environment as Authorization: Bearer <secret>
CRON_SECRET=YOUR_CRON_SECRET
REVALIDATE_SOLUTIONS=3600
REVALIDATE_COMPANY=86400
REVALIDATE_NEWSROOM=300
REVALIDATE_INNOVATION=3600
