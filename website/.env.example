# PrecisionCore public website environment template
# Copy to website/.env.local and replace placeholders with real values.

# Payload CMS / PostgreSQL
# Use a separate Postgres schema from the API/portal to keep Payload tables isolated.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=payload
PAYLOAD_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Contentful
CONTENTFUL_SPACE_ID=YOUR_CONTENTFUL_SPACE_ID
CONTENTFUL_DELIVERY_TOKEN=YOUR_CONTENTFUL_DELIVERY_TOKEN
CONTENTFUL_PREVIEW_TOKEN=YOUR_CONTENTFUL_PREVIEW_TOKEN
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_WEBHOOK_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Contentful -> Payload migration script
# The migration script reads CONTENTFUL_CDA_TOKEN directly.
# Set it to the appropriate Contentful delivery/CDA token when running the migration.
CONTENTFUL_CDA_TOKEN=YOUR_CONTENTFUL_CDA_TOKEN

# Cloudflare R2 / S3-compatible storage
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
S3_CMS_BUCKET=YOUR_R2_CMS_BUCKET
S3_INVESTOR_BUCKET=precisioncore-investor-documents
S3_PRESIGN_EXPIRY=3600
R2_PUBLIC_URL=https://YOUR_PUBLIC_R2_HOSTNAME

# SMTP / Payload email
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=you@example.com

# Greenhouse ATS
ATS_API_KEY=YOUR_GREENHOUSE_API_KEY
ATS_BOARD_TOKEN=precisioncore

# Site URLs
NEXT_PUBLIC_SITE_URL=https://precisioncore.com
NEXT_PUBLIC_PORTAL_URL=https://portal.precisioncore.com

# Public site -> partner portal shared secret
PORTAL_API_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ISR / revalidation intervals (seconds)
REVALIDATE_CAREERS=1800
REVALIDATE_SOLUTIONS=3600
REVALIDATE_COMPANY=86400
REVALIDATE_NEWSROOM=300
REVALIDATION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
