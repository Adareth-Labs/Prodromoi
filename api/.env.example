# PrecisionCore API environment template
# Copy to api/.env and replace placeholders with real values.

# Runtime
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# PostgreSQL / Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Redis (optional in the current env schema; defaults to local Redis)
REDIS_URL=redis://localhost:6379

# Supabase Auth
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Cloudflare R2 / S3-compatible storage
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
S3_DOCUMENTS_BUCKET=YOUR_R2_DOCUMENTS_BUCKET
S3_PRESIGN_EXPIRY=3600

# SMTP2Go
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=you@example.com
SMTP_FROM_NAME=PrecisionCore Automotive

# Public-site authentication secret
PUBLIC_SITE_API_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# CORS / rate limiting
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
