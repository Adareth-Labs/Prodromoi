NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public
REDIS_URL=redis://localhost:6379

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Cloudflare R2
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_DOCUMENTS_BUCKET=your-documents-bucket
R2_PRESIGN_EXPIRY=3600

SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=YOUR_FROM_EMAIL@example.com
SMTP_FROM_NAME=PrecisionCore Automotive

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOG_LEVEL=info
LOG_DIR=./logs
