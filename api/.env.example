# PrecisionCore API — local development environment template
NODE_ENV=development
PORT=3002
API_BASE_URL=http://localhost:3002
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
REDIS_URL=redis://localhost:6379

# Supabase Auth (use the same project that authenticates API users)
SUPABASE_URL=https://YOUR_AUTH_PROJECT_REF.supabase.co
# The API validates Supabase JWTs using SUPABASE_URL/JWKS; no Supabase secret key is needed here.

# Supabase Storage S3 protocol (server-only credentials generated in Storage > S3 Configuration)
# This may point at precisioncore-public even if Auth uses a different Supabase project.
SUPABASE_STORAGE_S3_ENDPOINT=https://YOUR_STORAGE_PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_S3_REGION=eu-west-1
SUPABASE_STORAGE_S3_ACCESS_KEY_ID=YOUR_SUPABASE_STORAGE_S3_ACCESS_KEY_ID
SUPABASE_STORAGE_S3_SECRET_ACCESS_KEY=YOUR_SUPABASE_STORAGE_S3_SECRET_ACCESS_KEY
SUPABASE_STORAGE_DOCUMENTS_BUCKET=partner-private
STORAGE_SIGNED_URL_EXPIRY=3600
# If deployed behind exactly one trusted reverse proxy, set TRUST_PROXY_HOPS=1; otherwise keep 0.
TRUST_PROXY_HOPS=0
# Set to the deployed portal URL in production.
PORTAL_URL=http://localhost:3000

# SMTP2Go (required in production; optional for local development)
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_USER
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=api@precisioncore.com
SMTP_FROM_NAME=PrecisionCore Automotive

# CORS / logging
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=debug
LOG_DIR=./logs
# Optional strong bearer token for /metrics; required if you expose metrics in production.
# METRICS_BEARER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# LEGACY CLOUDFLARE R2 SETTINGS — disabled; kept here for rollback reference only.
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
# R2_DOCUMENTS_BUCKET=precisioncore-documents
# R2_PRESIGN_EXPIRY=3600
