# PrecisionCore Partner Portal environment template
# Copy to partner-portal/.env.local and replace placeholders with real values.

# Runtime
NODE_ENV=development

# PostgreSQL / Prisma
# The portal uses the shared schema at ../api/prisma/schema.prisma.
# Keep this on the same database/schema as the API (normally ?schema=public).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Cloudflare R2 / S3-compatible storage
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
S3_PRESIGN_EXPIRY=3600
S3_BUCKET_RFQ=rfq-docs
S3_BUCKET_PPAP=ppap-vault

# Shared secret used by the public website to call /api/rfq/initiate
PORTAL_API_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
