NEXT_PUBLIC_API_BASE_URL=http://localhost:3002 # Use your deployed API URL in production

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy key name is still supported by the client factories if needed:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY



# Public Supabase Storage bucket base URL for automotive imagery.
# Upload optimized images into site-media/automotive/ before setting this value.
NEXT_PUBLIC_SUPABASE_STORAGE_PUBLIC_URL=https://YOUR_STORAGE_PROJECT_REF.supabase.co/storage/v1/object/public/site-media
